{
  "name": "@alfred/desktop-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "build:voice-ui": "pnpm --filter @alfred/voice-client run build:desktop",
    "start": "pnpm run build:voice-ui && tsx src/main.ts"
  },
  "dependencies": {
    "@alfred/briefing": "workspace:^",
    "@alfred/contracts": "workspace:^",
    "@alfred/livekit": "workspace:^",
    "@alfred/memory": "workspace:^",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
