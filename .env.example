# ALFRED Conversation Core — environment template
# Copy to .env and fill values locally. Never commit real secrets.

NODE_ENV=development

# --- Cascaded voice stack (M2) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Alias accepted by voice-agent:
# ELEVEN_API_KEY=

ELEVENLABS_VOICE_ID=qXcNpxDCD6dKvASibF0r
# LLM preset: instant | conversational | deliberate (default conversational → gpt-5.6-terra, reasoning none)
ALFRED_LLM_PRESET=conversational
ALFRED_PROFILE_ID=profile.default

# Local-first long-term memory (default for pnpm voice)
# Providers: memory.local (JSONL) | memory.oip-local (filesystem OIP packages)
# memory.local path defaults to ./data/memory/{ALFRED_PROFILE_ID}.jsonl when unset
ALFRED_MEMORY_PROVIDER_ID=memory.local
# ALFRED_MEMORY_PATH=
# memory.oip-local root defaults to ./data/memory-oip/{ALFRED_PROFILE_ID}/ when unset
# ALFRED_MEMORY_OIP_PATH=

# OpenClaw-style persona bootstrap (SOUL.md / IDENTITY.md / USER.md)
# Defaults to ./data/persona/{ALFRED_PROFILE_ID}/
# ALFRED_PERSONA_DIR=

# LiveKit media transport (required for pnpm voice)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=alfred-dev
LIVEKIT_IDENTITY=alfred-agent
# Optional: only subscribe to this participant's mic (default: all remote audio)
# LIVEKIT_TARGET_IDENTITY=

# --- Desktop client alfrd.net connectivity (pnpm desktop) ---
# Reuses the existing Fly.io control plane / relay at api.alfrd.net
ALFRD_CLOUD_URL=https://api.alfrd.net
ALFRD_RELAY_URL=wss://api.alfrd.net
ALFRD_CLOUD_DISABLED=false
DESKTOP_CLIENT_NAME=Alfred
PORT=3000
# Optional override for identity JSON (default: ./data/desktop-client/identity.json)
# ALFRED_DESKTOP_IDENTITY_PATH=

# Optional debug
ALFRED_LOG_PLAYBACK=0
ALFRED_LOG_STT=0
ALFRED_LOG_VOICE=1
# After TTS, keep matching mic STT against assistant/user-turn text (ms).
# Fuzzy echo (Devin≈Devon, debit≈digital) and short junk ignored; long novel speech barges in.
# ALFRED_ECHO_COOLDOWN_MS=2500
# Agent-side mic-vs-TTS PCM gate (drop self-echo before Deepgram). Default on.
# ALFRED_SELF_VOICE=0
# ALFRED_SELF_VOICE_THRESHOLD=0.6
# Set to 1 to enable live network voice tests (not used by default CI)
ALFRED_LIVE_VOICE_TESTS=0

# Postgres (deferred — interfaces exist; M1/M2 voice path uses in-memory)
DATABASE_URL=postgres://alfred:alfred@localhost:5432/alfred

# Observability (noop exporter still; latency marks emit as domain events)
OTEL_EXPORTER_OTLP_ENDPOINT=
